# GEMINI_API_KEY: Required for Gemini AI API calls (doubt analysis, session summaries, feedback).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: Connection string for MongoDB Atlas or local MongoDB.
# If omitted in preview, PeerConnect AI automatically initializes an embedded MongoDB instance with seed data.
MONGODB_URI="mongodb://127.0.0.1:27017/peerconnect_ai"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
JWT_SECRET="replace_with_secure_random_jwt_secret_key_2026"

# AGORA_APP_ID: Agora App ID for real-time WebRTC peer video sessions.
AGORA_APP_ID=""

# AGORA_APP_CERTIFICATE: Optional Agora primary certificate for token generation.
AGORA_APP_CERTIFICATE=""

# VITE_AGORA_APP_ID: Optional client-side Agora App ID fallback.
VITE_AGORA_APP_ID=""

# NODEMAILER SMTP CONFIGURATION: For sending real verification OTP emails to registered students.
# If not set, Nodemailer automatically provisions an Ethereal SMTP test inbox and provides an email preview link.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PeerConnect AI <no-reply@peerconnect.ai>"


